{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "description": "複数の契約で使う部品。",
  "$defs": {
    "app_id": {
      "description": "対象のアプリの ID。部品の辞書ごとに一つ。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "examples": ["calculator"]
    },
    "part_name": {
      "description": "部品の辞書の中の、部品の名前。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "examples": ["7", "足す", "等号", "表示"]
    },
    "key": {
      "description": "押すキー。印字できる ASCII の 1 文字（空白を除く）か、名前付きのキー（名前は DOM の KeyboardEvent.key に合わせる）。修飾キーとの同時押しは PoC では扱わない。",
      "type": "string",
      "anyOf": [
        { "pattern": "^[!-~]$" },
        {
          "enum": [
            "Enter",
            "Escape",
            "Backspace",
            "Delete",
            "Tab",
            " ",
            "ArrowUp",
            "ArrowDown",
            "ArrowLeft",
            "ArrowRight"
          ]
        }
      ],
      "examples": ["7", "+", "=", "Enter", "Escape"]
    },
    "point": {
      "description": "タップする位置。ウィンドウの外枠の左上を原点とした、物理ピクセルの座標。runner は実行の前にウィンドウを命令の window.size にそろえる。",
      "type": "object",
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "timestamp": {
      "description": "日時。RFC 3339（タイムゾーン付き）。",
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "description": "server が振る ID。中身の形は server が決め、他の部品は不透明な文字列として扱う。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "error": {
      "description": "失敗したときの理由。",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "description": "人が読む説明（日本語）。", "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
