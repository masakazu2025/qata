{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunnerCommand",
  "description": "server から runner への命令。server が変換の枠で部品の名前を基本の操作（key・tap・read_text）に変えてから送る。runner は部品の辞書もテストケースも知らない。runner はアプリを起動し直してから、ステップを順に実行し、ステップごとにスクショを撮る。",
  "type": "object",
  "properties": {
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "app": {
      "type": "object",
      "properties": {
        "launch": { "$ref": "#/$defs/launch" },
        "window": { "$ref": "#/$defs/window" }
      },
      "required": ["launch", "window"],
      "additionalProperties": false
    },
    "screenshot": { "$ref": "#/$defs/screenshot_settings" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "required": ["run_id", "app", "screenshot", "steps"],
  "additionalProperties": false,
  "$defs": {
    "launch": {
      "description": "アプリの起動のしかた。",
      "type": "object",
      "properties": {
        "command": {
          "description": "起動するコマンド。",
          "type": "string",
          "minLength": 1,
          "examples": ["calc.exe"]
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "window": {
      "description": "操作するウィンドウの見つけ方と大きさ。",
      "type": "object",
      "properties": {
        "title": {
          "description": "ウィンドウのタイトル。完全一致で探す。",
          "type": "string",
          "minLength": 1,
          "examples": ["電卓"]
        },
        "size": {
          "description": "実行の前にそろえるウィンドウの大きさ（物理ピクセル）。座標はこの大きさを前提にする。省略したら大きさを変えない（全画面のアプリなど）。",
          "type": "object",
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "required": ["width", "height"],
          "additionalProperties": false
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "screenshot_settings": {
      "description": "スクショの撮り方。window：対象のウィンドウだけ。all_screens：つないでいるすべての画面をまとめて一枚（全画面で複数の画面にまたがるアプリのため）。どちらにするかは、server がアプリごとの設定から決める。",
      "type": "object",
      "properties": {
        "scope": { "enum": ["window", "all_screens"] }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/key" },
        { "$ref": "#/$defs/tap" },
        { "$ref": "#/$defs/read_text" }
      ],
      "discriminator": { "propertyName": "type" }
    },
    "key": {
      "type": "object",
      "properties": {
        "type": { "const": "key" },
        "key": { "$ref": "common.schema.json#/$defs/key" }
      },
      "required": ["type", "key"],
      "additionalProperties": false
    },
    "tap": {
      "type": "object",
      "properties": {
        "type": { "const": "tap" },
        "point": { "$ref": "common.schema.json#/$defs/point" }
      },
      "required": ["type", "point"],
      "additionalProperties": false
    },
    "read_text": {
      "description": "画面の文字を読んで返す。読み方は source で選ぶ。値の取り出しと期待値との比較は server が行う。",
      "type": "object",
      "properties": {
        "type": { "const": "read_text" },
        "source": { "$ref": "#/$defs/text_source" }
      },
      "required": ["type", "source"],
      "additionalProperties": false
    },
    "text_source": {
      "description": "文字の読み方。アプリによって使える手段が違うので、手段を足せるようにしておく（decisions.md の D17）。PoC では uia だけ。",
      "oneOf": [{ "$ref": "#/$defs/text_source_uia" }],
      "discriminator": { "propertyName": "method" }
    },
    "text_source_uia": {
      "description": "UI Automation で AutomationId の要素を探し、その Name を読む。",
      "type": "object",
      "properties": {
        "method": { "const": "uia" },
        "automation_id": { "type": "string", "minLength": 1 }
      },
      "required": ["method", "automation_id"],
      "additionalProperties": false
    }
  }
}
